# PostgreSQL connection string from Supabase/Neon/Railway/etc.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Make this a long random secret before deploying.
JWT_SECRET=replace-with-a-long-random-secret

# GitHub Pages URL, e.g. https://username.github.io/webclass
FRONTEND_ORIGINS=https://YOUR-USERNAME.github.io

# Change these after first deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin2705

PORT=3000
